ARG BASE_IMAGE=nvcr.m.daocloud.io/nvidia/pytorch:25.08-py3

FROM ${BASE_IMAGE}

ARG APT_MIRROR=https://mirrors.aliyun.com
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV AWS_EC2_METADATA_DISABLED=true

WORKDIR /opt/ComfyUI

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|http://archive.ubuntu.com|${APT_MIRROR}|g; s|http://security.ubuntu.com|${APT_MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages \
    --timeout 120 --retries 10 \
    -r requirements.txt \
    runai-model-streamer-s3

COPY . .

EXPOSE 8188

CMD ["python3", "main.py", "--listen", "0.0.0.0"]
