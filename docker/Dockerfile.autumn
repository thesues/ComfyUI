ARG BASE_IMAGE=dongmao-test-cn-beijing.cr.volces.com/dongmao-test/comfyui-autumn:7e292fb46743051be9175e780495b842a9a5d43f

FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1

WORKDIR /opt/ComfyUI

RUN pip uninstall -y runai-model-streamer-s3

COPY . .

EXPOSE 8188

CMD ["python3", "main.py", "--listen", "0.0.0.0"]
