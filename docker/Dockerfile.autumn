ARG BASE_IMAGE=dongmao-test-cn-beijing.cr.volces.com/dongmao-test/freetoken-l3:3c43c273a485d93903dc45bd6b3a43684f6ba152

FROM ${BASE_IMAGE}

# Probed from the CP build agent with the same 100 MB wheel: ivolces 480 MB/s,
# volces (public) 13.6 MB/s, aliyun 0.18 MB/s, pypi.org 0.04 MB/s. But the
# volcengine mirror is incomplete for the Comfy pins (no templates 0.11.59,
# comfy-kitchen, comfy-aimdo, comfyui_manager 4.2.2, ... — run #20), so aliyun
# stays as the fallback. pip has no index priority and took identical files
# from aliyun (16-65 min requirements step); the install below uses uv, whose
# unsafe-best-match strategy reads each version from the highest-priority
# index that has it, so aliyun only serves what ivolces lacks.
ARG COMFY_PIP_INDEX_URL=https://mirrors.ivolces.com/pypi/simple/
ARG COMFY_PIP_FALLBACK_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

ENV PIP_INDEX_URL=${COMFY_PIP_INDEX_URL}
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV AWS_EC2_METADATA_DISABLED=true

WORKDIR /opt/ComfyUI

# No apt layer: the base already ships the newest ca-certificates and git
# (apt reported both "already the newest version"), and the aliyun apt mirror
# is ~400 KB/s from the CP build agent: the index refresh cost 70-100 s.
# Purging git would not shrink the image either — it lives in a base layer.

# torchvision/torchaudio go in FIRST, pinned to the base's torch 2.11.0+cu130,
# and the whole torch stack is then frozen with a constraints file. Without
# this, spandrel/kornia pull torchvision from PyPI during the requirements
# install; pip picks the newest (0.29 -> torch==2.14), backtracks through
# 0.28/torch 2.13 to 0.27.1/torch 2.12.1, downloading ~1.6 GB of torch wheels
# plus ~940 MB of nvidia/triton wheels from aliyun — 60 of the 69 build
# minutes — and finally REPLACES the base torch, breaking freetoken's
# torch<2.12 / triton==3.6.0 pins. With the pins pip fails fast instead.
RUN pip install --break-system-packages \
      --timeout 120 --retries 10 \
      --no-deps --index-url https://download.pytorch.org/whl/cu130 \
      torchvision==0.26.0 torchaudio==2.11.0 \
    && python3 -c "from importlib.metadata import version as v; print('\n'.join(f'{p}=={v(p)}' for p in ('torch', 'torchvision', 'torchaudio', 'triton')))" \
      > /etc/pip-torch-constraints.txt \
    && cat /etc/pip-torch-constraints.txt

# The Manager comes from PyPI (manager_requirements.txt pins comfyui_manager),
# not a git clone: the CP build agent cannot reach github.com at all (run #17
# timed out connecting to port 443). As a package it lives in site-packages,
# so the deployment's bind mount over custom_nodes cannot hide it; it is
# switched on with --enable-manager.
COPY requirements.txt manager_requirements.txt ./
# Download caches on BuildKit cache mounts: repeat builds on the same agent
# skip the download without paying image size (cache mounts never enter a
# layer). uv itself is fetched from ivolces alone first — with aliyun listed,
# pip took the 20 MB wheel from aliyun at 222 KB/s (88 s, run #21) — and only
# falls back to aliyun if ivolces cannot serve it.
# The final find_spec check fails the build if uv --system wrote to a
# different site-packages than the one python3 imports from.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    { pip install --break-system-packages --timeout 120 --retries 10 \
        --index-url ${COMFY_PIP_INDEX_URL} uv \
      || pip install --break-system-packages --timeout 120 --retries 10 \
        --index-url ${COMFY_PIP_INDEX_URL} --extra-index-url ${COMFY_PIP_FALLBACK_INDEX_URL} uv; } \
    && sed -E '/^(torch|torchvision|torchaudio)([<>=~! ].*)?$/d' requirements.txt > /tmp/requirements-no-torch.txt \
    && UV_HTTP_TIMEOUT=120 UV_LINK_MODE=copy uv pip install --system --break-system-packages \
      --index ${COMFY_PIP_INDEX_URL} \
      --default-index ${COMFY_PIP_FALLBACK_INDEX_URL} \
      --index-strategy unsafe-best-match \
      -c /etc/pip-torch-constraints.txt \
      -r /tmp/requirements-no-torch.txt \
      -r manager_requirements.txt \
    && python3 -c "import importlib.util as u, sys; m = [n for n in ('comfy_kitchen', 'comfy_aimdo', 'comfyui_manager', 'comfyui_workflow_templates', 'spandrel') if u.find_spec(n) is None]; sys.exit(f'not importable: {m}' if m else 0)"

COPY . .

# ComfyUI listens on 0.0.0.0, so the Manager's default network_mode=public
# refuses node installs ("network_mode must be set to personal_cloud").
# personal_cloud is safe here only because every external request passes the
# nginx auth proxy (comfyui-auth-proxy) in front of this pod. user/ is not
# bind-mounted by the live deployment, so this file is the one the Manager
# reads; it fills every other key with its defaults.
RUN mkdir -p user/__manager \
    && printf '[default]\nnetwork_mode = personal_cloud\n' > user/__manager/config.ini

# Node installs from the Manager run through uv by default (comfyui_manager
# depends on uv), which ignores PIP_INDEX_URL — so set both. ivolces measured
# on the cluster at ~300 MB/s vs ~30 MB/s aliyun (same wheel, 3 runs each).
# The constraints keep a node's requirements from swapping out the base torch
# the way the build once did. HF_ENDPOINT routes model downloads through
# hf-mirror — huggingface.co is unreachable from this cluster.
ENV UV_INDEX_URL=${COMFY_PIP_INDEX_URL} \
    PIP_CONSTRAINT=/etc/pip-torch-constraints.txt \
    UV_CONSTRAINT=/etc/pip-torch-constraints.txt \
    HF_ENDPOINT=https://hf-mirror.com \
    HF_MIRROR=https://hf-mirror.com

EXPOSE 8188

CMD ["python3", "main.py", "--listen", "0.0.0.0", "--enable-manager"]
