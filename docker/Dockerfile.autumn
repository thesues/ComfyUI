ARG BASE_IMAGE=dongmao-test-cn-beijing.cr.volces.com/dongmao-test/freetoken-l3:3c43c273a485d93903dc45bd6b3a43684f6ba152

FROM ${BASE_IMAGE}

ARG COMFY_PIP_INDEX_URL=https://mirrors.ivolces.com/pypi/simple/
ARG COMFY_PIP_EXTRA_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

ENV PIP_INDEX_URL=${COMFY_PIP_INDEX_URL}
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV AWS_EC2_METADATA_DISABLED=true

WORKDIR /opt/ComfyUI

# apt layer: only main is needed (ca-certificates + git). The base image's
# aliyun sources cover universe/multiverse/backports — ~40 MB of indexes
# never used here — and the CUDA repo inherited from the pytorch base pulls
# a few MB more per update. Cache mounts keep the debs between builds;
# docker-clean is removed first or it deletes every .deb and defeats them.
RUN rm -f /etc/apt/apt.conf.d/docker-clean
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    printf '%s\n' \
      'deb https://mirrors.aliyun.com/ubuntu/ jammy main restricted' \
      'deb https://mirrors.aliyun.com/ubuntu/ jammy-updates main restricted' \
      'deb https://mirrors.aliyun.com/ubuntu/ jammy-security main restricted' \
      > /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/cuda-*.list \
    && apt-get update -o Acquire::Languages=none \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      git

COPY requirements.txt .
# pip's download cache on a BuildKit cache mount: repeat builds skip the
# download without paying image size (cache mounts never enter a layer).
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    sed -E '/^(torch|torchvision|torchaudio)([<>=~! ].*)?$/d' requirements.txt > /tmp/requirements-no-torch.txt \
    && pip install --break-system-packages \
      --timeout 120 --retries 10 --extra-index-url ${COMFY_PIP_EXTRA_INDEX_URL} \
      -r /tmp/requirements-no-torch.txt \
    && pip install --break-system-packages \
      --timeout 120 --retries 10 \
      --no-deps --index-url https://download.pytorch.org/whl/cu130 \
      torchvision torchaudio

# Clone the Manager BEFORE `COPY . .`: it only changes when the pinned
# upstream moves, so ComfyUI code edits reuse this layer instead of
# re-cloning from GitHub on every build.
RUN git clone --depth 1 https://github.com/Comfy-Org/ComfyUI-Manager.git \
      custom_nodes/ComfyUI-Manager

# git was needed only for that clone; do not ship ~50 MB of VCS in the pod.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get purge -y --auto-remove git

COPY . .

# The manager shells out to pip for node installs; point it at the volcengine
# mirror — measured on the cluster at ~300 MB/s vs ~30 MB/s aliyun (same
# wheel, 3 runs each; ustc/tuna in between). It also honours the in-UI
# override, which persists to config.ini. HF_ENDPOINT routes model downloads
# through hf-mirror — huggingface.co is unreachable from this cluster.
RUN printf '[default]\npip_index_url = https://mirrors.ivolces.com/pypi/simple/\n' \
      > custom_nodes/ComfyUI-Manager/config.ini
ENV HF_ENDPOINT=https://hf-mirror.com \
    HF_MIRROR=https://hf-mirror.com

EXPOSE 8188

CMD ["python3", "main.py", "--listen", "0.0.0.0"]
